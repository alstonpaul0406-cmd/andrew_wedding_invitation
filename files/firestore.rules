rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'msg', 'c', 't'])
        && request.resource.data.keys().hasOnly(['name', 'msg', 'c', 't', 's'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.msg is string
        && request.resource.data.msg.size() <= 120
        && request.resource.data.c is int
        && request.resource.data.c >= 0
        && request.resource.data.c <= 3
        && request.resource.data.t == request.time;
      allow update, delete: if false;
    }
  }
}
